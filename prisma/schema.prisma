// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Grade {
  A
  B_PLUS
  B
  C_PLUS
  C
  D_PLUS
  D
  F
}

enum Plan {
  PLAN
  ACTUAL
}

enum CourseType {
  GEN_ED
  MAJOR_REQUIRED
  MAJOR_ELECTIVE
  MINOR
  FREE_ELECTIVE
}

model User {
  id         String   @id @default(uuid())
  name       String
  password   String
  email      String   @unique
  created_at DateTime @default(now())

  goals     Goal[]
  semesters Semester[]
  gpa       GPA[]
  chat_logs ChatLog[]
  password_reset_tokens PasswordResetToken[]
}

model Semester {
  id          String   @id @default(uuid())
  year        Int
  term        String
  term_no     Int
  is_complete Boolean
  created_at  DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  courses Course[]
  gpas    GPA[]
  goals   Goal[]

  @@unique([year, term_no, user_id])
  @@index([user_id])
}

model Course {
  id          String     @id @default(uuid())
  name        String
  category    CourseType
  grade       Grade
  grade_point Float
  credit      Int
  type        Plan
  created_at  DateTime   @default(now())

  semester_id String
  semester    Semester @relation(fields: [semester_id], references: [id], onDelete: Cascade)

  @@index([semester_id])
}

model GPA {
  user_id            String
  semester_id        String
  gpa                Float
  cum_gpa            Float
  total_credits      Int
  total_grade_points Float
  calculated_at      DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semester_id], references: [id], onDelete: Cascade)

  @@id([user_id, semester_id])
  @@index([user_id])
  @@index([semester_id])
}

model Goal {
  id                 String   @id @default(uuid())
  name               String   @default("")
  target_gpa         Float
  is_achieved        Boolean  @default(false)
  target_semester_id String
  target_semester    Semester @relation(fields: [target_semester_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([target_semester_id])
}

model ChatLog {
  id          String   @id @default(uuid())
  input_data  String
  ai_response String
  context     String?
  created_at  DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

enum OtpPurpose {
  reset_password
}

model Otp {
  id         String     @id @default(uuid())
  email      String
  otp        String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expires_at DateTime
  created_at DateTime   @default(now())

  @@unique([email, purpose])
  @@index([email])
  @@index([expires_at])
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  token       String   @unique
  expires_at  DateTime
  created_at  DateTime @default(now())

  user_id     String
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}
