// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Grade {
  A
  B_PLUS
  B
  C_PLUS
  C
  D_PLUS
  D
  F
}

enum Plan {
  PLAN
  ACTUAL
}

enum CourseType {
  GEN_ED
  MAJOR_REQUIRED
  MAJOR_ELECTIVE
  MINOR
  FREE_ELECTIVE
}

enum AcademicTaskType {
  ASSIGNMENT
  EXAM
  QUIZ
  PROJECT
  OTHER
}

enum NotificationDeliveryStatus {
  PENDING
  CLAIMED
  SENT
  FAILED
}

model User {
  id         String   @id @default(uuid())
  name       String
  password   String
  email      String   @unique
  created_at DateTime @default(now())

  goals     Goal[]
  semesters Semester[]
  gpa       GPA[]
  chat_logs ChatLog[]
  password_reset_tokens PasswordResetToken[]
  refresh_sessions      RefreshSession[]
  degree_requirements   DegreeRequirement[]
  import_operations     ImportOperation[]
  push_subscriptions    PushSubscription[]
}

model Semester {
  id          String   @id @default(uuid())
  year        Int
  term        String
  term_no     Int
  is_complete Boolean
  created_at  DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  courses Course[]
  gpas    GPA[]
  goals   Goal[]

  @@unique([year, term_no, user_id])
  @@index([user_id])
}

model Course {
  id          String     @id @default(uuid())
  name        String
  category    CourseType
  grade       Grade
  grade_point Float
  credit      Int
  type        Plan
  created_at  DateTime   @default(now())
  course_code String?
  instructor  String?
  notes       String?

  semester_id String
  semester    Semester @relation(fields: [semester_id], references: [id], onDelete: Cascade)

  requirement_id String?
  requirement    DegreeRequirement? @relation(fields: [requirement_id], references: [id], onDelete: SetNull)
  meetings         CourseMeeting[]
  tasks            AcademicTask[]
  prerequisites    CoursePrerequisite[] @relation("CoursePrerequisites")
  prerequisite_for CoursePrerequisite[] @relation("RequiredCourse")

  @@index([semester_id])
  @@index([requirement_id])
}

model CourseMeeting {
  id           String @id @default(uuid())
  weekday      Int
  start_minute Int
  end_minute   Int
  location     String?
  course_id    String
  course       Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([course_id])
}

model AcademicTask {
  id                      String           @id @default(uuid())
  title                   String
  type                    AcademicTaskType
  due_at                  DateTime
  notes                   String?
  is_complete             Boolean          @default(false)
  reminder_offset_minutes Int?             @default(1440)
  created_at              DateTime         @default(now())
  course_id               String
  course                  Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  notification_deliveries NotificationDelivery[]

  @@index([course_id])
  @@index([due_at])
}

model PushSubscription {
  id         String   @id @default(uuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([user_id])
}

model NotificationDelivery {
  id              String                     @id @default(uuid())
  scheduled_for   DateTime
  status          NotificationDeliveryStatus @default(PENDING)
  attempts        Int                        @default(0)
  available_at    DateTime                   @default(now())
  claimed_at      DateTime?
  sent_at         DateTime?
  last_error      String?
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @updatedAt
  task_id         String
  task            AcademicTask               @relation(fields: [task_id], references: [id], onDelete: Cascade)
  subscription_id String
  subscription    PushSubscription           @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@unique([task_id, subscription_id, scheduled_for])
  @@index([status, available_at, scheduled_for])
  @@index([subscription_id])
}

model CoursePrerequisite {
  course_id        String
  prerequisite_id String
  course           Course @relation("CoursePrerequisites", fields: [course_id], references: [id], onDelete: Cascade)
  prerequisite     Course @relation("RequiredCourse", fields: [prerequisite_id], references: [id], onDelete: Cascade)

  @@id([course_id, prerequisite_id])
  @@index([prerequisite_id])
}

model DegreeRequirement {
  id               String   @id @default(uuid())
  name             String
  required_credits Int
  color            String?
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())
  user_id          String
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  courses          Course[]

  @@index([user_id])
}

model GPA {
  user_id            String
  semester_id        String
  gpa                Float
  cum_gpa            Float
  total_credits      Int
  total_grade_points Float
  projected_gpa                Float @default(0)
  projected_total_credits      Int   @default(0)
  projected_total_grade_points Float @default(0)
  calculated_at      DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semester_id], references: [id], onDelete: Cascade)

  @@id([user_id, semester_id])
  @@index([user_id])
  @@index([semester_id])
}

model Goal {
  id                 String   @id @default(uuid())
  name               String   @default("")
  target_gpa         Float
  is_achieved        Boolean  @default(false)
  target_semester_id String
  target_semester    Semester @relation(fields: [target_semester_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([target_semester_id])
}

model ChatLog {
  id          String   @id @default(uuid())
  input_data  String
  ai_response String
  context     String?
  created_at  DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

enum OtpPurpose {
  reset_password
}

model Otp {
  id         String     @id @default(uuid())
  email      String
  otp        String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expires_at DateTime
  created_at DateTime   @default(now())

  @@unique([email, purpose])
  @@index([email])
  @@index([expires_at])
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  token       String   @unique
  expires_at  DateTime
  created_at  DateTime @default(now())

  user_id     String
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model RefreshSession {
  id           String    @id @default(uuid())
  token_hash   String    @unique
  family_id    String
  device_info  String?
  ip_address   String?
  expires_at   DateTime
  last_used_at DateTime  @default(now())
  revoked_at   DateTime?
  created_at   DateTime  @default(now())

  user_id String
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at])
}

model ImportOperation {
  id         String   @id @default(uuid())
  key        String
  response   Json
  created_at DateTime @default(now())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, key])
  @@index([created_at])
}
